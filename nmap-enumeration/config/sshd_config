Port 22
ListenAddress 0.0.0.0
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ed25519_key
# Packaged Nmap retrieves RSA keys through the ssh-rsa host-key exchange.
# User authentication remains disabled for this isolated training service.
HostKeyAlgorithms +ssh-rsa
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication no
PermitRootLogin no
UsePAM no
AllowUsers nobody
PidFile /run/mfano-sshd.pid
LogLevel ERROR
